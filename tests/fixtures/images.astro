---
import Frame from '@layouts/frame.astro';
import Prose from '@layouts/components/Prose.astro';
import Image from '@layouts/components/Image.astro';
import importedPortrait from './assets/image-test-portrait.svg';
---

<Frame title="Image checks" withLeftSidebar={false}>
  <Prose>
    <h1>Images</h1>
    <figure id="known">
      <Image src="/landscape.svg" alt="Landscape" loading="eager" /><figcaption>
        A quiet landscape
      </figcaption>
    </figure>
    <figure id="partial">
      <Image
        src="/partial.png"
        alt="Partially downloaded"
        width="640"
        height="360"
        loading="eager"
      />
    </figure>
    <figure id="unknown">
      <Image src="__REMOTE_IMAGE__" alt="Remote portrait" loading="eager" />
    </figure>
    <figure id="broken">
      <Image src="/missing-image.svg" alt="Missing image" loading="eager" />
    </figure>
    <figure id="fixed">
      <Image
        src="/portrait.svg"
        alt="Cropped portrait"
        ratio="16 / 9"
        loading="eager"
      />
    </figure>
    <figure id="sized">
      <Image
        src="/landscape.svg"
        width={320}
        alt="Half width"
        loading="eager"
      />
    </figure>
    <figure id="imported">
      <Image
        src={importedPortrait}
        width={120}
        alt="Imported SVG"
        loading="eager"
      />
    </figure>
    <figure id="raw">
      <img src="/portrait.svg" alt="Raw Astro image" loading="eager" />
    </figure>
    <figure id="picture">
      <picture
        ><source srcset="/portrait.svg" type="image/svg+xml" /><img
          src="/landscape.svg"
          width="240"
          height="480"
          alt="Picture source"
          loading="eager"
        /></picture
      >
    </figure>
    <div style="height:15000px"></div>
    <figure id="far">
      <Image src="/far.svg" alt="Far away" width="320" height="180" />
    </figure>
  </Prose>
</Frame>
