---
import Frame from '@layouts/frame.astro';
import Prose from '@layouts/components/Prose.astro';
import Image from '@layouts/components/Image.astro';
---

<Frame title="Image viewer" withLeftSidebar={false}>
  <Prose>
    <h1>Image viewer</h1>
    <figure id="first">
      <Image
        src="/thumb.svg"
        originalSrc="/large.svg"
        alt="Landscape"
        loading="eager"
      /><figcaption>A quiet landscape</figcaption>
    </figure>
    <figure id="slow">
      <Image
        src="/thumb.svg"
        originalSrc="/slow.svg"
        alt="Portrait"
        loading="eager"
      />
    </figure>
    <figure id="error">
      <Image
        src="/thumb.svg"
        originalSrc="/missing.svg"
        alt="Unavailable original"
        loading="eager"
      />
    </figure>
    <figure id="off">
      <Image src="/thumb.svg" alt="No lightbox" lightbox={false} />
    </figure>
    <a href="/destination" id="linked"
      ><Image src="/thumb.svg" alt="Linked image" /></a
    >
  </Prose>
</Frame>
