---
import Widget from '@widgets/sidebar/Widget.astro';
---

<Widget title="Editor's margin">
  <p>
    This note comes from the article's own <code>_right.astro</code>. The
    article TOC stays above it.
  </p>
  <p>
    Compare the spacing around headings, the rhythm of dialogue, and the
    readability of longer tables.
  </p>
  <a href="/demo">Return to the page demos</a>
</Widget>

<style>
  p,
  a {
    margin: 0;
    font-size: var(--ny-font-size-ui);
    line-height: var(--ny-line-height-prose);
  }

  p {
    color: var(--ny-color-text-muted);
  }
</style>
