---
const { pathname } = Astro.props;
const links = [
  { href: '/demo', label: 'All demos' },
  { href: '/demo/markdown', label: 'Plain Markdown' },
  { href: '/demo/notes/nested', label: 'Nested MDX notebook' },
  { href: '/demo/studio', label: 'Astro studio' },
  { href: '/posts/typography-test', label: 'Bundled article' },
];
---

<nav aria-label="Content demos">
  {
    links.map(({ href, label }) => (
      <a
        href={href}
        aria-current={
          pathname?.replace(/\/$/, '') === href ? 'page' : undefined
        }
      >
        {label}
      </a>
    ))
  }
</nav>

<style>
  nav {
    display: grid;
    gap: var(--ny-space-3);
    font-size: var(--ny-font-size-ui);
  }

  a {
    color: var(--ny-color-text-muted);
    text-decoration: none;
  }

  a:hover,
  a[aria-current='page'] {
    color: var(--ny-color-primary);
    text-decoration: underline;
  }
</style>
