---
import type { MarkdownHeading } from 'astro';
import Widget from '@widgets/sidebar/Widget.astro';
import DemoLinks from '~/content/pages/demo/_DemoLinks.astro';
interface Props {
  headings: MarkdownHeading[];
  pathname: string;
}
const { headings, pathname } = Astro.props;
---

<Widget title="In this notebook">
  <nav aria-label="Notebook headings">
    {
      headings
        .filter((heading) => heading.depth === 2)
        .map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)
    }
  </nav>
</Widget>
<Widget title="Margin note">
  <p>
    This right sidebar belongs to the notebook. The left widgets use the site
    default.
  </p>
</Widget>
<Widget title="Explore the demos">
  <DemoLinks pathname={pathname} />
</Widget>

<style>
  nav {
    display: grid;
    gap: var(--ny-space-3);
  }

  nav,
  p {
    font-size: var(--ny-font-size-ui);
    line-height: var(--ny-line-height-prose);
  }

  p {
    margin: 0;
    color: var(--ny-color-text-muted);
  }
</style>
