---
import excerpt from '~/content/assets/demo-excerpt.txt?raw';
export const page = {
  title: 'A Small Creative Studio',
  description:
    'An Astro content page with two local sidebars and a shared text asset.',
};
const projects = [
  {
    title: 'Field notes',
    detail: 'Collect small observations before they disappear.',
    href: '/demo/notes/nested',
  },
  {
    title: 'Reading room',
    detail: 'A quiet space for lists, quotes, and longer thoughts.',
    href: '/demo/markdown',
  },
  {
    title: 'Manuscript lab',
    detail: 'Explore the rhythm of headings, dialogue, lists, and tables.',
    href: '/posts/typography-test',
  },
];
---

<p>
  This studio is an Astro page. Its project list is rendered from local data,
  and both sidebars are composed beside its <code>index.astro</code>.
</p>

<h2>On the worktable</h2>
<div class="projects">
  {
    projects.map((project) => (
      <section>
        <h3>
          <a href={project.href}>{project.title}</a>
        </h3>
        <p>{project.detail}</p>
      </section>
    ))
  }
</div>

<h2>A shared note</h2>
<blockquote><p>{excerpt.trim()}</p></blockquote>
<p>
  This excerpt is imported from <code>src/content/assets/demo-excerpt.txt</code
  >. Shared resources can be imported without becoming pages.
</p>

<h2>Make it your own</h2>
<p>
  The left sidebar replaces the default widgets with demo navigation. The right
  sidebar adds a studio note. The profile and footer remain part of the theme.
</p>
<p><a href="/demo">Back to all demos</a></p>

<style>
  .projects {
    display: grid;
    gap: var(--ny-space-4);
  }

  section {
    padding: var(--ny-space-4);
    border: 1px solid var(--ny-color-border);
    border-radius: var(--ny-radius-md);
    background: var(--ny-color-surface);
  }

  section h3,
  section p {
    margin: 0;
  }

  section p {
    margin-top: var(--ny-space-2);
    color: var(--ny-color-text-muted);
  }
</style>
