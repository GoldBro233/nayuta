---
import Widget from '@widgets/sidebar/Widget.astro';
---

<Widget title="Studio notes">
  <p>
    A local right sidebar can hold a reading list, project status, or a small
    personal note.
  </p>
  <p>
    Today: collecting ideas, rearranging sentences, and leaving time for tea.
  </p>
</Widget>

<style>
  p {
    margin: 0;
    color: var(--ny-color-text-muted);
    font-size: var(--ny-font-size-ui);
    line-height: var(--ny-line-height-prose);
  }
</style>
