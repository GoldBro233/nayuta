---
import TagCloud from '@widgets/sidebar/TagCloud.astro';
import RecentPosts from '@widgets/sidebar/RecentPosts.astro';
import WebsiteStatus from '@widgets/sidebar/WebsiteStatus.astro';
import SearchWidget from '@widgets/sidebar/SearchWidget.astro';

interface Props {
  name: string;
}

const { name } = Astro.props;
---

{name === 'tag-cloud' && <TagCloud />}
{name === 'recent-posts' && <RecentPosts />}
{name === 'website-status' && <WebsiteStatus />}
{name === 'search' && <SearchWidget />}
