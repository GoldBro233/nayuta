---
import TagCloud from './TagCloud.astro';
import RecentPosts from './RecentPosts.astro';
import WebsiteStatus from './WebsiteStatus.astro';
import SearchWidget from './SearchWidget.astro';

interface Props {
  name: string;
}

const { name } = Astro.props;
---

{name === 'tag-cloud' && <TagCloud />}
{name === 'recent-posts' && <RecentPosts />}
{name === 'website-status' && <WebsiteStatus />}
{name === 'search' && <SearchWidget />}
