---
import Input from '@layouts/components/Input.astro';
import Widget from '@widgets/sidebar/Widget.astro';
---

<Widget title="Search Site">
  <label class="search-field">
    <span class="visually-hidden">Search site</span>
    <Input type="search" placeholder="Search this site..." />
    <i class="fa-solid fa-magnifying-glass search-icon" aria-hidden="true"></i>
  </label>
</Widget>

<style>
  .search-field {
    position: relative;
    display: block;
  }

  .search-field :global(.search-input) {
    padding-left: calc(var(--ny-space-2) * 2 + var(--ny-font-size-icon));
  }

  .search-icon {
    position: absolute;
    top: 50%;
    left: var(--ny-space-2);
    transform: translateY(-50%);
    color: var(--ny-color-text-subtle);
    font-size: var(--ny-font-size-ui-meta);
    pointer-events: none;
  }

  .search-field:focus-within .search-icon {
    color: var(--ny-color-outline);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
