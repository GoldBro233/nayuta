---
import { getPosts } from '@assets/utils/posts';
import Badge from '@layouts/components/Badge.astro';
import Widget from '@widgets/sidebar/Widget.astro';

const posts = await getPosts();

// Sort by publishDate descending and take the first 3 posts
const recentPosts = [...posts]
  .sort(
    (a, b) =>
      new Date(b.data.publishDate).getTime() -
      new Date(a.data.publishDate).getTime(),
  )
  .slice(0, 3);
---

<Widget title="Recent Posts" moreHref="/posts">
  <div class="post-list">
    {
      recentPosts.map((post) => (
        <a href={`/posts/${post.id}`} class="post-item">
          <span class="post-title">
            {post.data.draft && <Badge variant="draft">Draft</Badge>}
            {post.data.title}
          </span>
          <div class="post-meta">
            <span>{post.data.publishDate}</span>
          </div>
        </a>
      ))
    }
  </div>
</Widget>

<style>
  .post-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .post-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
  }

  .post-title {
    --ny-badge-font-size: var(--ny-font-size-ui-micro);

    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--ny-space-1);
    color: var(--ny-color-text);
    font-size: var(--ny-font-size-ui);
    font-weight: 500;
    line-height: 1.4;
    transition: color 0.15s ease;
  }

  .post-item:hover .post-title {
    color: var(--ny-color-outline);
    text-decoration: underline;
  }

  .post-meta {
    display: flex;
    gap: 12px;
    font-size: var(--ny-font-size-ui-meta);
    color: var(--ny-color-text-subtle);
  }
</style>
