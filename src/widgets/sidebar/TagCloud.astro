---
import { getPosts } from '@assets/utils/posts';
import Tag from '@layouts/components/Tag.astro';
import Widget from '@widgets/sidebar/Widget.astro';

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

{
  tags.length > 0 && (
    <Widget title="Tags Cloud">
      <div class="tag-cloud">
        {tags.map((tag) => (
          <Tag href={`/tag/${encodeURIComponent(tag)}`}>{tag}</Tag>
        ))}
      </div>
    </Widget>
  )
}

<style>
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ny-space-2);
  }
</style>
