---
interface Props {
  class?: string;
  href?: string;
  rel?: string;
}

const { class: className = '', href, rel } = Astro.props;
const Element = href ? 'a' : 'span';
---

<Element
  href={href}
  rel={href ? rel : undefined}
  class={`tag-item ${className}`.trim()}
>
  <slot />
</Element>

<style>
  .tag-item {
    display: inline-block;
    max-width: 100%;
    overflow-wrap: anywhere;
    font-size: var(--ny-tag-font-size, var(--ny-font-size-ui-micro));
    background-color: var(--ny-color-surface-container);
    border: 1px solid var(--ny-color-border);
    color: var(--ny-color-text-muted);
    padding: 2px 6px;
    border-radius: var(--ny-radius-xs);
    cursor: pointer;
    text-decoration: none;
  }

  .tag-item:hover {
    border-color: var(--ny-color-outline);
    color: var(--ny-color-text);
  }

  .tag-item:focus-visible {
    outline: 2px solid var(--ny-color-outline);
    outline-offset: 2px;
  }
</style>
