---
import { getCollection } from 'astro:content';
import Frame from '../../layouts/frame.astro';
import Prose from '../../components/Prose.astro';
import ProfileCard from '../../widgets/ProfileCard.astro';
import PostList from '../../widgets/PostList.astro';
import RecentPosts from '../../widgets/RecentPosts.astro';
import WebsiteStatus from '../../widgets/WebsiteStatus.astro';
import Widget from '../../widgets/Widget.astro';

const posts = await getCollection('posts');

const breadcrumbs = [
  { text: 'Home', href: '/' },
  { text: 'Posts', href: '/posts' },
];
---

<Frame title="Posts" breadcrumbs={breadcrumbs} withRightSidebar={true}>
  <ProfileCard slot="left-header" />
  <RecentPosts slot="left" />
  <WebsiteStatus slot="left" />

  <Prose>
    <h1 class="page-title">Posts</h1>

    <PostList posts={posts} />
  </Prose>

  <Widget slot="right" title="Series Bulletin">
    <div class="widget-content-simple">
      <div><strong>Current Work:</strong> The Pale Landscape</div>
      <div><strong>Label:</strong> GF Bunko</div>
      <div><strong>Editor:</strong> Kenjirou Toki</div>
      <div><strong>Status:</strong> Naked writing mode ✍️</div>
    </div>
  </Widget>

  <style>
    .widget-content-simple {
      font-size: 12px;
      color: var(--ny-color-text-muted);
      line-height: 1.7;
    }
  </style>
</Frame>
