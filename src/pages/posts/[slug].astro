---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { formatReadingTime } from '../../utils/reading-time';
import Frame from '../../layouts/frame.astro';
import Prose from '../../components/Prose.astro';
import Tag from '../../components/Tag.astro';
import ProfileCard from '../../widgets/ProfileCard.astro';
import RecentPosts from '../../widgets/RecentPosts.astro';
import TagCloud from '../../widgets/TagCloud.astro';
import WebsiteStatus from '../../widgets/WebsiteStatus.astro';
import TableOfContents from '../../widgets/TableOfContents.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const readingTime = formatReadingTime(
  remarkPluginFrontmatter.readingTimeMinutes,
);

const breadcrumbs = [
  { text: 'Home', href: '/' },
  { text: 'Posts', href: '/posts' },
  { text: post.data.title, href: `/posts/${post.id}` },
];
---

<Frame
  title={post.data.title}
  withRightSidebar={true}
  breadcrumbs={breadcrumbs}
>
  <ProfileCard slot="left-header" />
  <RecentPosts slot="left" />
  <TagCloud slot="left" />
  <WebsiteStatus slot="left" />

  <Prose>
    {
      post.data.cover && (
        <div class="post-cover-container">
          {typeof post.data.cover === 'string' ? (
            <img
              class="post-cover"
              src={post.data.cover}
              alt={post.data.title}
            />
          ) : (
            <Image
              class="post-cover"
              src={post.data.cover}
              alt={post.data.title}
            />
          )}
        </div>
      )
    }

    <h1 class="page-title">{post.data.title}</h1>
    <p style="color: var(--ny-color-text-subtle); margin-bottom: 20px;">
      Published: {post.data.publishDate} &nbsp;•&nbsp; Reading Time: {
        readingTime
      }
    </p>

    <Content />
  </Prose>

  {
    post.data.tags.length > 0 && (
      <nav class="post-tags" aria-label="Post tags">
        <ul>
          {post.data.tags.map((tag) => (
            <li>
              <Tag href={`/tag/${encodeURIComponent(tag)}`} rel="tag">
                {tag}
              </Tag>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <TableOfContents slot="right" headings={headings} />
</Frame>

<style>
  .post-tags {
    margin-top: var(--ny-space-6);
    padding-top: var(--ny-space-4);
    border-top: 1px solid var(--ny-color-border);
  }

  .post-tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ny-space-2);
    list-style: none;
  }

  .post-tags li {
    min-width: 0;
    max-width: 100%;
  }
</style>

<style is:global>
  /* Premium post-specific cover styles */
  .post-cover-container {
    width: 100%;
    margin: 16px 0 28px 0;
    border-radius: var(--ny-radius-lg);
    overflow: hidden;
    border: 1px solid var(--ny-color-border);
    aspect-ratio: 16 / 9;
    background-color: var(--ny-color-surface-container);
    box-shadow: 0 8px 30px var(--ny-color-shadow);
  }

  .prose .post-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    border: none;
    border-radius: 0;
  }
</style>
