---
import Frame from '../layout/frame.astro';
import RecentPosts from '../widgets/sidebar/RecentPosts.astro';
import WebsiteStatus from '../widgets/sidebar/WebsiteStatus.astro';
---

<Frame
  title="404"
  breadcrumbs={[
    { text: 'Home', href: '/' },
    { text: '404', href: '/404.html' },
  ]}
>
  <meta slot="head" name="robots" content="noindex" />

  <RecentPosts slot="left" />
  <WebsiteStatus slot="left" />

  <h1 class="not-found" aria-label="404: Page not found">404</h1>
</Frame>

<style>
  .not-found {
    display: grid;
    place-items: center;
    min-block-size: 60vh;
    padding-block: var(--ny-space-6);
    color: var(--ny-color-text);
    font-family: var(--ny-font-ui);
    font-size: clamp(6rem, 16vw, 12rem);
    font-weight: 700;
    line-height: 1;
  }
</style>
