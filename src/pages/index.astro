---
import { getContentPages } from '@assets/utils/pages';
import ContentPage from '@layouts/widgets/ContentPage.astro';
const page = (await getContentPages()).find((page) => page.isHome);
if (!page) {
  throw new Error(
    'Add one homepage at src/content/index.md, index.mdx or index.astro.',
  );
}
---

<ContentPage page={page} />
