---
import { renderContentPage, type ContentPage } from '@assets/utils/pages';
import PageTemplate from '@templates/PageTemplate.astro';
import FriendTemplate from '@templates/FriendTemplate.astro';
interface Props {
  page: ContentPage;
}
const { page } = Astro.props;
const { Content, headings } = await renderContentPage(page);
const Template =
  page.entry.data.template === 'friend' ? FriendTemplate : PageTemplate;
---

<Template
  entry={page.entry}
  Content={Content}
  headings={headings}
  isHome={page.isHome}
/>
