---
import Frame from '@layouts/content-frame.astro';
import type { TemplateProps } from '@type/template';
import Prose from '@layouts/components/Prose.astro';

interface Props extends TemplateProps {}

const { entry, content: Content, headings = [], isHome = false } = Astro.props;
const data = entry.data;

const breadcrumbs =
  data.breadcrumbs ||
  (isHome
    ? [{ text: 'Home', href: '/' }]
    : [
        { text: 'Home', href: '/' },
        { text: data.title, href: Astro.url.pathname },
      ]);
---

<Frame
  title={data.title}
  isHome={isHome}
  breadcrumbs={breadcrumbs}
  entry={entry}
  headings={headings}
>
  <Prose>
    <h1 class="page-title">{data.title}</h1>
    {Content && <Content entry={entry} headings={headings} />}
  </Prose>
</Frame>
