---
import Frame from '@layouts/frame.astro';
import type { MarkdownHeading } from 'astro';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import type { PageEntry } from '@assets/utils/pages';
import RecentPosts from '@widgets/sidebar/RecentPosts.astro';
import TagCloud from '@widgets/sidebar/TagCloud.astro';
import WebsiteStatus from '@widgets/sidebar/WebsiteStatus.astro';
import Prose from '@layouts/components/Prose.astro';
import DynamicWidget from '@widgets/sidebar/DynamicWidget.astro';

interface Props {
  entry: PageEntry;
  Content?: AstroComponentFactory;
  headings?: MarkdownHeading[];
  isHome?: boolean;
}

const { entry, Content, isHome = false } = Astro.props;
const data = entry.data;

const breadcrumbs = data.breadcrumbs || [
  { text: 'Home', href: '/' },
  { text: data.title, href: Astro.url.pathname },
];

const rightWidgets: string[] = [];
const showRightSidebar =
  typeof data.withRightSidebar === 'boolean'
    ? data.withRightSidebar
    : rightWidgets.length > 0;
---

<Frame
  title={data.title}
  isHome={isHome}
  breadcrumbs={breadcrumbs}
  withRightSidebar={showRightSidebar}
>
  <RecentPosts slot="left" />
  <TagCloud slot="left" />
  <WebsiteStatus slot="left" />

  <Prose>
    <h1 class="page-title">{data.title}</h1>
    {Content && <Content />}
  </Prose>

  {
    showRightSidebar && rightWidgets.length > 0 && (
      <Fragment slot="right">
        {rightWidgets.map((name) => (
          <DynamicWidget name={name} />
        ))}
      </Fragment>
    )
  }
</Frame>
