---
import Frame from '@layouts/content-frame.astro';
import type { MarkdownHeading } from 'astro';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import type { PageEntry } from '@assets/utils/pages';
import Prose from '@layouts/components/Prose.astro';

interface Props {
  entry: PageEntry;
  Content?: AstroComponentFactory;
  headings?: MarkdownHeading[];
  isHome?: boolean;
}

const { entry, Content, headings = [], isHome = false } = Astro.props;
const data = entry.data;

const breadcrumbs =
  data.breadcrumbs ||
  (isHome
    ? [{ text: 'Home', href: '/' }]
    : [
        { text: 'Home', href: '/' },
        { text: data.title, href: Astro.url.pathname },
      ]);
---

<Frame
  title={data.title}
  isHome={isHome}
  breadcrumbs={breadcrumbs}
  entry={entry}
  headings={headings}
>
  <Prose>
    <h1 class="page-title">{data.title}</h1>
    {Content && <Content entry={entry} headings={headings} />}
  </Prose>
</Frame>
