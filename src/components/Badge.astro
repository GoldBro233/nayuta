---
interface Props {
  class?: string;
  variant?: 'default' | 'draft';
}

const { class: className = '', variant = 'default' } = Astro.props;
---

<span
  class={`badge ${variant === 'draft' ? 'badge-draft' : ''} ${className}`.trim()}
>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--ny-color-border);
    border-radius: var(--ny-radius-xs);
    color: var(--ny-color-text-muted);
    background-color: var(--ny-color-surface-container);
    font-size: var(--ny-badge-font-size, var(--ny-font-size-ui-micro));
    line-height: 1.4;
    padding: 1px 6px;
    vertical-align: middle;
  }

  .badge-draft {
    flex-shrink: 0;
    border: 0;
    padding: 0;
    color: var(--ny-color-text-subtle);
    background-color: transparent;
    font-weight: 500;
    text-transform: lowercase;
    white-space: nowrap;
  }

  .badge-draft::before {
    content: '[';
  }

  .badge-draft::after {
    content: ']';
  }
</style>
