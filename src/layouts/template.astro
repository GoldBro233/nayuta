---
import { renderContentPage, type ContentPage } from '@assets/utils/pages';
import Frame from '@layouts/frame.astro';
import { parseTemplateEntry } from '@templates/define';
import { getTemplate } from '@templates/registry';

interface Props {
  page: ContentPage;
}

const { page } = Astro.props;
const definition = getTemplate(
  page.entry.data.template,
  page.entry.filePath ?? page.entry.id,
);
const entry = parseTemplateEntry(definition, page.entry);
const { Content, headings } = await renderContentPage(page);
const { default: Template } = await definition.load();
const { isHome } = page;
const breadcrumbs =
  entry.data.breadcrumbs ??
  (isHome
    ? [{ text: 'Home', href: '/' }]
    : [
        { text: 'Home', href: '/' },
        { text: entry.data.title, href: Astro.url.pathname },
      ]);
---

<Frame
  entry={entry}
  headings={headings}
  isHome={isHome}
  breadcrumbs={breadcrumbs}
>
  <Template entry={entry} headings={headings} isHome={isHome}>
    <Content entry={entry} headings={headings} />
  </Template>
</Frame>
