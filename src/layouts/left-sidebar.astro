---
import SidebarFooter from './sidebar-footer.astro';
---

<aside class="left-region" id="left-sidebar">
  <header class="left-header">
    <slot name="header" />
  </header>

  <div class="left-sidebar-content">
    <slot />
  </div>

  <SidebarFooter className="left-footer" />
</aside>

<style>
  .left-region {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .left-header {
    flex-shrink: 0;
  }

  .left-sidebar-content {
    display: flex;
    flex-direction: column;
    gap: 28px;
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--ny-color-border) transparent;
    padding-right: 6px;
  }

  .left-sidebar-content::-webkit-scrollbar {
    width: 4px;
  }

  .left-sidebar-content::-webkit-scrollbar-track {
    background: transparent;
  }

  .left-sidebar-content::-webkit-scrollbar-thumb {
    background: var(--ny-color-border);
    border-radius: var(--ny-radius-xs);
  }

  .left-sidebar-content::-webkit-scrollbar-thumb:hover {
    background: var(--ny-color-outline);
  }
</style>
