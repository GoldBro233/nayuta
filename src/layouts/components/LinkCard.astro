---
import Card from '@layouts/components/Card.astro';

interface Props {
  name: string;
  href: string;
  site?: string;
  desc?: string;
  favicon?: string;
  faviconText?: string;
  faviconBg?: string;
  faviconColor?: string;
  tag?: string;
  tags?: string[];
}

const {
  name,
  href,
  favicon,
  faviconText = name ? name.trim().slice(0, 1).toUpperCase() : '?',
  faviconBg,
  faviconColor,
  tag,
  tags = tag ? [tag] : [],
} = Astro.props;

const imageSrc = favicon;

let site = Astro.props.site;
if (!site && href) {
  try {
    site = new URL(href).hostname;
  } catch {
    site = href.replace(/^https?:\/\//, '').replace(/\/.*$/, '');
  }
}

const desc = Astro.props.desc || '';

const fallbackStyle = [
  faviconBg ? `background-color: ${faviconBg};` : '',
  faviconColor ? `color: ${faviconColor};` : '',
]
  .filter(Boolean)
  .join(' ');
---

<Card href={href} target="_blank" class="link-card">
  <div class="link-header">
    <div class="avatar-wrapper">
      {
        imageSrc ? (
          <img src={imageSrc} alt={name} class="link-favicon" loading="lazy" />
        ) : (
          <div
            class="link-favicon link-favicon-fallback"
            style={fallbackStyle || undefined}
          >
            {faviconText}
          </div>
        )
      }
    </div>
    <div class="link-info">
      <div class="name-row">
        <span class="link-name">{name}</span>
        <svg class="external-icon" viewBox="0 0 24 24" width="12" height="12">
          <path
            d="M5 19L19 5M19 5H9M19 5V15"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            fill="none"></path>
        </svg>
      </div>
      {site && <span class="link-site">{site}</span>}
    </div>
  </div>
  {
    desc && (
      <p class="link-desc" title={desc}>
        {desc}
      </p>
    )
  }
  {
    tags.length > 0 && (
      <div class="link-tags">
        {tags.map((t) => (
          <span class="link-tag">{t}</span>
        ))}
      </div>
    )
  }
</Card>

<style>
  :global(.link-card) {
    background-color: var(--ny-color-surface);
    border: 1px solid var(--ny-color-border);
    border-radius: var(--ny-radius-md);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none !important;
    color: inherit;
    position: relative;
    overflow: hidden;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.link-card:hover) {
    transform: translateY(-3px);
    border-color: var(--ny-color-outline);
    background-color: var(--ny-color-surface-elevated);
    box-shadow:
      0 8px 24px var(--ny-color-shadow),
      0 0 0 1px color-mix(in srgb, var(--ny-color-outline) 15%, transparent);
  }

  .link-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .avatar-wrapper {
    flex-shrink: 0;
  }

  .link-favicon {
    width: 44px;
    height: 44px;
    border-radius: var(--ny-radius-sm);
    object-fit: cover;
    border: 1px solid var(--ny-color-border);
    background-color: var(--ny-color-surface-container);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
    display: block;
  }

  :global(.link-card:hover) .link-favicon {
    transform: scale(1.05);
    border-color: var(--ny-color-outline);
  }

  .link-favicon-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--ny-font-size-prose);
    font-weight: 700;
    font-family: var(--ny-font-ui);
    user-select: none;
    background-color: color-mix(
      in srgb,
      var(--ny-color-primary) 15%,
      transparent
    );
    color: var(--ny-color-outline);
  }

  .link-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }

  .name-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  .link-name {
    font-size: var(--ny-font-size-prose);
    line-height: var(--ny-line-height-heading);
    font-weight: 700;
    color: var(--ny-color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.15s ease;
  }

  :global(.link-card:hover) .link-name {
    color: var(--ny-color-outline);
  }

  .external-icon {
    color: var(--ny-color-text-subtle);
    opacity: 0.35;
    transform: translate(-2px, 2px);
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  :global(.link-card:hover) .external-icon {
    opacity: 1;
    transform: translate(0, 0);
    color: var(--ny-color-outline);
  }

  .link-site {
    font-size: var(--ny-font-size-meta);
    line-height: var(--ny-line-height-compact);
    color: var(--ny-color-text-subtle);
    font-family: var(--ny-font-code);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .link-desc {
    font-size: var(--ny-font-size-prose-small);
    color: var(--ny-color-text-muted);
    line-height: var(--ny-line-height-compact);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    min-height: 2lh;
  }

  .link-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: 4px;
  }

  .link-tag {
    font-size: var(--ny-font-size-meta);
    line-height: var(--ny-line-height-compact);
    font-family: var(--ny-font-code);
    color: var(--ny-color-text-subtle);
    background-color: var(--ny-color-surface-container);
    border: 1px solid var(--ny-color-border);
    padding: 1px 6px;
    border-radius: var(--ny-radius-xs);
  }
</style>
