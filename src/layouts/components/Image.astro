---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';
import { resolveImageDimensions } from '@assets/utils/image-metadata';

interface Props extends Omit<HTMLAttributes<'img'>, 'src'> {
  src?: string | ImageMetadata;
  alt: string;
  /** A fixed presentation ratio, such as "16 / 9" for cropped covers. */
  ratio?: string;
  lightbox?: boolean;
  originalSrc?: string;
}

const {
  src,
  alt,
  ratio,
  lightbox = true,
  originalSrc,
  style,
  ...attributes
} = Astro.props;
const metadata = typeof src === 'object' ? src : undefined;
const optimized = metadata ? await getImage({ src: metadata }) : undefined;
const url = optimized?.src ?? (typeof src === 'string' ? src : undefined);
const dimensions =
  metadata ?? (url ? await resolveImageDimensions(url, attributes) : undefined);
const width = attributes.width ?? dimensions?.width;
const height = attributes.height ?? dimensions?.height;
const imageRatio =
  ratio ?? (width && height ? `${width} / ${height}` : '16 / 9');
---

<nayuta-image
  data-lightbox={lightbox ? undefined : 'off'}
  data-fixed-ratio={ratio}
  data-original-src={originalSrc ?? metadata?.src ?? url}
  style={`--ny-image-ratio:${imageRatio};${!ratio && width ? `--ny-image-width:${Number(width)}px;` : ''}`}
>
  <div class="ny-image-placeholder" aria-hidden="true"></div>
  <img
    {...optimized?.attributes}
    {...attributes}
    src={url}
    alt={alt}
    width={width}
    height={height}
    loading={attributes.loading ?? 'lazy'}
    decoding="async"
    style={style}
  />
</nayuta-image>
