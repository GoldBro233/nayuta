---
import Avatar from '../components/Avatar.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import config from '../../config';

const links = config.links ?? [];
---

<div class="profile-card">
  <a class="avatar-link" href="/" aria-label="Go to homepage">
    <Avatar src={config.avatar} alt="" />
  </a>
  <div class="profile-info">
    <h2 class="profile-name">{config.author}</h2>
    <div class="profile-title">
      {config.description}
    </div>
  </div>

  {
    links.length > 0 && (
      <div class="social-buttons">
        {links.map((link) => {
          const href = link.url || link.href || '#';
          const isExternal =
            href.startsWith('http://') || href.startsWith('https://');
          const target = link.target ?? (isExternal ? '_blank' : undefined);
          const iconOnly = link.iconOnly ?? !link.text;

          return (
            <Button
              href={href}
              target={target}
              iconOnly={iconOnly}
              ariaLabel={link.ariaLabel ?? link.text}
            >
              {link.icon && <Icon icon={link.icon} />}
              {link.text && <span>{link.text}</span>}
            </Button>
          );
        })}
      </div>
    )
  }
</div>

<style>
  .avatar-link {
    display: inline-flex;
    width: fit-content;
    border-radius: var(--ny-radius-md);
  }

  .avatar-link:focus-visible {
    outline: 2px solid var(--ny-color-outline);
    outline-offset: var(--ny-space-1);
  }

  .profile-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .profile-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .profile-name {
    font-size: var(--ny-font-size-ui-title);
    font-weight: 700;
    color: var(--ny-color-text);
  }

  .profile-title {
    font-size: var(--ny-font-size-ui-meta);
    line-height: 1.4;
    color: var(--ny-color-text-muted);
  }

  .social-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }
</style>
