---
import config from '~/config';
import {
  creativeCommonsLicenseUrls,
  type CreativeCommonsLicense,
} from '@type/copyright';

interface Props {
  title: string;
  pathname: string;
  license: CreativeCommonsLicense;
}

const { title, pathname, license } = Astro.props;
const permalink = new URL(pathname, config.site_url).href;
---

<aside class="copyright-card" aria-label="Article copyright and license">
  <p class="card-title">&copy; Copyright</p>
  <dl>
    <dt>Article</dt>
    <dd>{title}</dd>
    <dt>Author</dt>
    <dd>{config.author}</dd>
    <dt>Link</dt>
    <dd><a href={permalink}>{permalink}</a></dd>
    <dt>License</dt>
    <dd>
      <a href={creativeCommonsLicenseUrls[license]} rel="license">{license}</a>
    </dd>
  </dl>
</aside>

<style>
  .copyright-card {
    margin-top: var(--ny-space-6);
    padding: var(--ny-space-4);
    border: 1px solid var(--ny-color-border);
    border-radius: var(--ny-radius-md);
    background-color: var(--ny-color-surface);
    color: var(--ny-color-text-muted);
    font-size: var(--ny-font-size-ui);
    line-height: var(--ny-line-height-ui);
  }

  .card-title {
    margin: 0 0 var(--ny-space-3);
    color: var(--ny-color-text);
    font-weight: 700;
  }

  dl {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: var(--ny-space-4);
    row-gap: var(--ny-space-2);
    margin: 0 !important;
  }

  dt {
    color: var(--ny-color-text-subtle);
    margin: 0 !important;
  }

  dd {
    min-width: 0;
    margin: 0 !important;
    overflow-wrap: anywhere;
  }
</style>
